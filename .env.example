# ---- Database (docker compose or `pnpm db:embedded`) ----
DATABASE_URL="postgresql://fitflow:fitflow@localhost:5432/fitflow?schema=public"

# ---- Redis (used from Phase 1 for BullMQ jobs) ----
REDIS_URL="redis://localhost:6379"

# ---- Object storage (MinIO locally, R2/S3 in prod) ----
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="fitflow"
S3_SECRET_KEY="fitflow-secret"
S3_BUCKET="fitflow"

# ---- API ----
API_PORT=4000
# CHANGE THESE: long random strings (e.g. `openssl rand -base64 48`)
JWT_ACCESS_SECRET="dev-access-secret-change-me-dev-access-secret-change-me"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
CORS_ORIGINS="http://localhost:3000"
# "log" prints OTPs to the API console. "msg91" is wired in Phase 1.
OTP_PROVIDER="log"
# Requests/minute: public auth routes per IP, and everything else per user (or per IP).
AUTH_RATE_LIMIT=10
API_RATE_LIMIT=300
# Proxies allowed to set X-Forwarded-For (the web server, load balancer). "loopback" fits
# local dev; in production list their IPs/CIDRs, e.g. "loopback, 10.0.0.0/8". Never "true".
TRUST_PROXY="loopback"
# Swagger UI at /docs. Defaults to on, except when NODE_ENV=production.
# SWAGGER_ENABLED="false"

# ---- Web ----
API_URL="http://localhost:4000"

{
  "name": "@fitflow/db",
  "version": "0.0.0",
  "private": true,
  "description": "Prisma schema, migrations, seed and tenant-isolation helpers",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "generate": "prisma generate",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint src prisma scripts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "test": "node --import tsx --test src/tenancy.test.ts",
    "migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "migrate:reset": "dotenv -e ../../.env -- prisma migrate reset",
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "embedded": "tsx scripts/embedded-postgres.mts"
  },
  "dependencies": {
    "@fitflow/shared": "workspace:*",
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "@fitflow/config": "workspace:*",
    "@types/node": "22.20.7",
    "bcryptjs": "3.0.3",
    "dotenv-cli": "8.0.0",
    "embedded-postgres": "16.16.0-beta.19",
    "eslint": "9.39.5",
    "prisma": "6.19.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
